# Copy to .env.local for local development. Set the same names in Vercel for production.
# Variables starting with NEXT_PUBLIC_ are sent to the browser. Everything else stays on the server.

# --- Site and business details (shown in the footer and legal pages) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_POSTAL_ADDRESS=
NEXT_PUBLIC_JURISDICTION=

# --- Supabase (accounts, saved scenarios, telemetry) ---
# Public by design: the anon / publishable key only works within row level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses row level security. Used for account deletion, telemetry and rate limits.
SUPABASE_SERVICE_ROLE_KEY=
# SERVER ONLY. Salt for hashing client IPs before rate limiting. Any long random string.
RATE_LIMIT_SALT=

# --- Optimizer backend (called from the Next.js server, never from the browser) ---
BACKEND_URL=http://localhost:8000
# SERVER ONLY. Must match API_KEY on the backend.
BACKEND_API_KEY=

# --- Backend process (uvicorn) ---
# API_KEY=same-value-as-BACKEND_API_KEY
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_SECONDS=60
# ALLOWED_ORIGINS=   (leave empty: the browser no longer calls the backend directly)
