# Frontend (.env.local / Vercel project settings):
# URL of the Python backend. Leave unset for local dev (defaults to http://localhost:8000).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend (environment of the uvicorn process):
# Comma-separated origins allowed to call the API. Defaults to "*".
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
